// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model GamePlay {
  id          String   @id @default(cuid())
  shop        String
  customerId  String?
  orderId     String   @unique
  gameId      Int      // 1 to 9
  playedAt    DateTime @default(now())
  score       Int?
  won         Boolean  @default(false)
  prizeType   String?  // "COUPON", "PRODUCT", "NONE"
  prizeValue  String?  // "5_PERCENT", "NIA_LIPSTICK"
  email       String?
  couponCode  String?
  claimedAt   DateTime?
  phone       String?
  outcomeWin  Boolean?  // decided by the server when the play starts
  prizeId     String?   // PrizeConfig id
  prizeLabel  String?   // e.g. "10% OFF Coupon" or "FREE Velvet Lipstick"
  prizeKind   String?   // PERCENT | AMOUNT | FREE_PRODUCT
  rolledAt    DateTime?
  finishedAt  DateTime?
  delivery    String?   // code | order_edit | product_code
  deliveryNote String?
  omnisendStatus String?
  omnisendError String?
  deliveryError String?  // admin-only: why a free product could not be added to the order
  couponStartsAt DateTime?  // when the personal code becomes usable / stops being usable
  couponEndsAt DateTime?
  couponUsedAt DateTime?    // set when a reminder check finds the code was redeemed
  giftToken   String?   // secret part of the "view my gift" link (random, 16 characters)
  orderStatusUrl String?  // the customer-facing status page of the order
  orderName   String?     // e.g. #313906
  waStatus    String?   // sent | failed | skipped
  waError     String?
  waSentAt    DateTime?
  waReminders Int       @default(0)
  waLastAt    DateTime? // last WhatsApp message (win or reminder)

  @@index([giftToken])
}

model GameSettings {
  id           String  @id @default(cuid())
  shop         String  @unique
  activeGameId Int     @default(1) // used only when manualActive is true
  manualActive Boolean @default(false) // false = the live game follows the calendar (12-20 Oct)
  testMode     Boolean @default(false) // If true, all 9 games are unlocked and rules are relaxed for testing
  couponDays   Int     @default(7)   // how long a won coupon stays valid
  requireOrder Boolean @default(true) // a play needs a real order
  freeGiftDailyLimit Int @default(6)  // free products handed out per day, all games together
  spreadFreeGifts Boolean @default(true) // release the free gifts through the day instead of all at midnight
  omnisendKeyEnc String?                 // the Omnisend API key, encrypted (AES-256-GCM)
  omnisendMode String @default("auto")   // "off" | "auto" (send every win to Omnisend) | "button" (customer taps "Send to my WhatsApp")
  couponStartsAt DateTime?               // personal codes become usable from here (null = the campaign default, 21 Oct 2026 00:00 IST)
  couponEndsAt DateTime?                 // ... and stop here (null = the campaign default, 20 Nov 2026 00:00 IST)
  bikKeyEnc String?                      // Bik app key + secret (JSON), encrypted
  bikWinTemplate String?                 // Bik template ids
  bikReminderTemplate String?
  bikGiftTemplate String?
  bikMode String @default("auto")        // "off" | "auto"
  bikReminders Boolean @default(true)    // weekly reminders until the coupon is used or expires
  giftFallback String @default("pack")  // when a free product cannot be added to the order: "pack" = tag + note on the order, "code" = personal 100% code (one play per order)
}

// Per-game rules edited on the app's "Games & prizes" page.
model GameConfig {
  id          String  @id @default(cuid())
  shop        String
  gameId      Int
  enabled     Boolean @default(true)
  winChance   Int     @default(50) // % of plays that win a prize
  dailyLimit  Int     @default(6)  // max prizes handed out per day for this game

  @@unique([shop, gameId])
}

model PrizeConfig {
  id           String  @id @default(cuid())
  shop         String
  gameId       Int
  kind         String  // PERCENT | AMOUNT | FREE_PRODUCT
  value        Int?    // percent (5, 10) or rupees (50, 100)
  productId    String?
  variantId    String?
  productTitle String?
  productHandle String?
  imageUrl     String?
  share        Int     @default(1) // relative weight when a win is rolled
  dailyLimit   Int?    // optional cap for this prize per day
  active       Boolean @default(true)

  @@index([shop, gameId])
}
