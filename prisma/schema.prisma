// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model GamePlay {
  id          String   @id @default(cuid())
  shop        String
  customerId  String?
  orderId     String   @unique
  gameId      Int      // 1 to 9
  playedAt    DateTime @default(now())
  score       Int?
  won         Boolean  @default(false)
  prizeType   String?  // "COUPON", "PRODUCT", "NONE"
  prizeValue  String?  // "5_PERCENT", "NIA_LIPSTICK"
  email       String?
  couponCode  String?
  claimedAt   DateTime?
  phone       String?
  outcomeWin  Boolean?  // decided by the server when the play starts
  prizeId     String?   // PrizeConfig id
  prizeLabel  String?   // e.g. "10% OFF Coupon" or "FREE Velvet Lipstick"
  prizeKind   String?   // PERCENT | AMOUNT | FREE_PRODUCT
  rolledAt    DateTime?
  finishedAt  DateTime?
  delivery    String?   // code | order_edit | product_code
  deliveryNote String?
}

model GameSettings {
  id           String  @id @default(cuid())
  shop         String  @unique
  activeGameId Int     @default(1) // used only when manualActive is true
  manualActive Boolean @default(false) // false = the live game follows the calendar (12-20 Oct)
  testMode     Boolean @default(true) // If true, all 9 games are unlocked and rules are relaxed for testing
  couponDays   Int     @default(7)   // how long a won coupon stays valid
  requireOrder Boolean @default(true) // a play needs a real order
  freeGiftDailyLimit Int @default(6)  // free products handed out per day, all games together (one play per order)
}

// Per-game rules edited on the app's "Games & prizes" page.
model GameConfig {
  id          String  @id @default(cuid())
  shop        String
  gameId      Int
  enabled     Boolean @default(true)
  winChance   Int     @default(50) // % of plays that win a prize
  dailyLimit  Int     @default(6)  // max prizes handed out per day for this game

  @@unique([shop, gameId])
}

model PrizeConfig {
  id           String  @id @default(cuid())
  shop         String
  gameId       Int
  kind         String  // PERCENT | AMOUNT | FREE_PRODUCT
  value        Int?    // percent (5, 10) or rupees (50, 100)
  productId    String?
  variantId    String?
  productTitle String?
  productHandle String?
  imageUrl     String?
  share        Int     @default(1) // relative weight when a win is rolled
  dailyLimit   Int?    // optional cap for this prize per day
  active       Boolean @default(true)

  @@index([shop, gameId])
}
